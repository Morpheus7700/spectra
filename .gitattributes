# Normalise line endings in the repo regardless of each machine's core.autocrlf,
# which is a local setting CI does not share. The working tree was already mixed:
# tools/council/*.py and pyproject.toml were CRLF while packages/** was LF.
#
# eol=lf matters concretely for two things: a CRLF shebang makes a shell script fail
# on Linux with a baffling error, and CRLF changes the bytes of the JSON fixtures the
# Python side generates and the TypeScript side consumes.
* text=auto eol=lf

*.py    text eol=lf
*.pyi   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.sh    text eol=lf

# Windows-native scripts must keep CRLF or cmd.exe mis-parses them.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Generated; noisy in review.
uv.lock       -diff
*.gen.ts      -diff linguist-generated

*.png binary
*.jpg binary
*.h5  binary
*.pkl binary
*.pgm binary
