# Data — datasets are large and licence-restricted
data/raw/
data/cache/
*.h5

# Real-world captures are personal data (R16) and must never be committed.
# A survey records every neighbouring BSSID -- geolocatable via public wardriving
# databases -- and SSIDs routinely carry people's names. site.json for a real home
# is that home's floor plan. Simulator fixtures under apps/web/public/fixtures/ are
# generated and carry no identifiers; those stay tracked.
data/flat/
*.survey.jsonl
*.pkl

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Council transcripts may quote proprietary design discussion
tools/council/transcripts/

# Property-test databases can serialise input data
.hypothesis/

# CI scratch
accuracy-output.txt

# FeitCSI clones (Linux CSI toolchain), kept locally for the AX211-CSI experiment.
# Nested git repos with their own .env -- never absorb them into this tree.
/fc/
/fcapp/

# FeitCSI clones (Linux CSI toolchain), kept locally for the AX211-CSI experiment.
